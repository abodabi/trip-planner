rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each trip is private to its members: the memberEmails array on the doc
    // is both the access list (checked here) and the query key the app uses
    // to list a user's trips (array-contains).
    match /trips/{tripId} {
      allow read, update, delete: if request.auth != null &&
        request.auth.token.email in resource.data.memberEmails;
      allow create: if request.auth != null &&
        request.auth.token.email in request.resource.data.memberEmails;
    }
  }
}
